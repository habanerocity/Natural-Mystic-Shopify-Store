[
  {
    "name": "theme_info",
    "theme_name": "Themekit template theme",
    "theme_version": "1.0.0",
    "theme_author": "Natural Mystic",
    "theme_documentation_url": "https://github.com/Shopify/themekit",
    "theme_support_url": "https://www.lindyramirez.com"
  },
  {
    "name": "Nav Bar Color Settings",
    "settings": [
      {
        "type": "color",
        "id": "navbar_color",
        "label": "NavBar Background Color",
        "default": "#010101"
      }
    ]
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumb_nav",
        "label": "Show breadcrumb navigation"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "info": "Buttons, links, and highlights.",
        "default": "#C52C03"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Primary color (hover)",
        "info": "Darker shade used when hovering over buttons.",
        "default": "#9B2302"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#FEC016"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight color",
        "info": "For highlighted text, badges, and callouts.",
        "default": "#FFF3CD"
      },
      {
        "type": "color",
        "id": "color_alert",
        "label": "Alert color",
        "info": "For error messages, warnings, and sale or sold-out notices.",
        "default": "#D52F44"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Tile background",
        "info": "Background of the features grid tiles.",
        "default": "#E0E0E0"
      }
    ]
  },
  {
    "name": "Brand fonts",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_brand_fonts",
        "label": "Use G&Z brand fonts",
        "info": "Cormorant Garamond for headings and DM Sans for body text. When on, the Typography font pickers are ignored.",
        "default": true
      }
    ]
  },
  {
    "name": "Wishlist",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_wishlist",
        "label": "Enable wishlist",
        "info": "Shows the wishlist hearts on products, the wishlist icon in the header, and loads the Swym wishlist scripts. Turn on only when a compatible wishlist app is installed. When off, none of it is shown or loaded.",
        "default": false
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "The small icon shown in browser tabs and bookmarks. Upload a square PNG, at least 48 x 48 px (180 x 180 px or larger is best)."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading Font Styles"
      },
      {
        "type": "font_picker",
        "id": "header_text_font",
        "label": "Font",
        "default": "mono"
      },
      {
        "type": "header",
        "content": "Body Font Styles"
      },
      {
        "type": "font_picker",
        "id": "body_text_font",
        "label": "Font",
        "default": "mono"
      },
      {
        "type": "header",
        "content": "Body Font Size"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "label": "Font Size",
        "default": 16,
        "unit": "px",
        "min": 13,
        "max": 25,
        "step": 1
      },
      {
        "type": "header",
        "content": "Header Font Weight"
      },
      {
        "type": "range",
        "id": "header_font_weight",
        "label": "Font Weight",
        "default": 500,
        "min": 300,
        "max": 800,
        "step": 100
      }
    ]
  }
]