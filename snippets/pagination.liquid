{%- if paginate.pages > 1 -%}
    <nav class="theme-pagination" aria-label="Pagination">
        <ul class="theme-pagination__list">
            <li>
                {%- if paginate.previous.is_link -%}
                    <a class="theme-pagination__link theme-pagination__arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
                    </a>
                {%- else -%}
                    <span class="theme-pagination__link theme-pagination__arrow is-disabled" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                    </span>
                {%- endif -%}
            </li>
            {%- for part in paginate.parts -%}
                <li>
                    {%- if part.is_link -%}
                        <a class="theme-pagination__link" href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
                    {%- elsif part.title == paginate.current_page -%}
                        <span class="theme-pagination__link is-current" aria-current="page">{{ part.title }}</span>
                    {%- else -%}
                        <span class="theme-pagination__gap">{{ part.title }}</span>
                    {%- endif -%}
                </li>
            {%- endfor -%}
            <li>
                {%- if paginate.next.is_link -%}
                    <a class="theme-pagination__link theme-pagination__arrow" href="{{ paginate.next.url }}" aria-label="Next page">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
                    </a>
                {%- else -%}
                    <span class="theme-pagination__link theme-pagination__arrow is-disabled" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </span>
                {%- endif -%}
            </li>
        </ul>
    </nav>
{%- endif -%}
