{%- comment -%}
  Line icon used by product accordion items and attribute rows.
  Params: icon (built-in icon id, or 'none'), image (optional uploaded image that replaces the built-in icon),
          class (optional CSS class, defaults to the accordion icon class)
{%- endcomment -%}
{%- assign icon_class = class | default: 'pdp-accordion__icon' -%}
{%- if image != blank -%}
    {%- assign image_class = icon_class | append: ' ' | append: icon_class | append: '--image' -%}
    {{ image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: image_class }}
{%- elsif icon != blank and icon != 'none' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {%- case icon -%}
            {%- when 'document' -%}
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/>
            {%- when 'truck' -%}
                <path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7.5" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/>
            {%- when 'return' -%}
                <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
            {%- when 'leaf' -%}
                <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19c3-4 6-7 10-9"/>
            {%- when 'ruler' -%}
                <rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10.5 8v4M14.5 8v3M18.5 8v4"/>
            {%- when 'droplet' -%}
                <path d="M12 3s6 6.2 6 10.5a6 6 0 0 1-12 0C6 9.2 12 3 12 3z"/>
            {%- when 'shield' -%}
                <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
            {%- when 'clock' -%}
                <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
            {%- when 'heart' -%}
                <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
            {%- when 'info' -%}
                <circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="8" r=".6"/>
            {%- when 'bolt' -%}
                <path d="M13 2L4 14h7l-1 8 9-12h-7z"/>
            {%- when 'smile' -%}
                <circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8"/><path d="M9 9.5h.01M15 9.5h.01"/>
            {%- when 'moon' -%}
                <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
            {%- when 'bowl' -%}
                <path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M9 20h6"/><path d="M14 11l5-7"/>
            {%- when 'sparkle' -%}
                <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
            {%- when 'check' -%}
                <circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/>
            {%- when 'mug' -%}
                <path d="M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3v2M12 3v2"/>
            {%- when 'sun' -%}
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        {%- endcase -%}
    </svg>
{%- endif -%}
