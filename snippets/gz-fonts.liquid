{%- comment -%}
  G&Z Wellness Co. self-hosted brand fonts
  Cormorant Garamond (headings) + DM Sans (body), SIL Open Font License 1.1.

  Render this in layout/theme.liquid AFTER the theme's own <style> block that
  sets the --font-* variables, e.g. just before </head>:
    {% render 'gz-fonts' %}
{%- endcomment -%}

{%- comment -%} Preload only the two faces needed for the first screen {%- endcomment -%}
{{ 'dm-sans-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'cormorant-garamond-600.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

<style>
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'cormorant-garamond-500.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'cormorant-garamond-600.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'cormorant-garamond-400-italic.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ 'dm-sans-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ 'dm-sans-500.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Override Dawn's font-picker variables */
    --font-heading-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --font-heading-style: normal;
    --font-heading-weight: 600;

    --font-body-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 500; /* only 400 and 500 ship, so "bold" maps to 500 instead of a faked bold */

    /* Brand helpers for custom sections */
    --gz-font-accent: 'Cormorant Garamond', Georgia, serif;
  }

  /* This theme's font-styles.css sets font-family directly, so apply the variables here */
  body { font-family: var(--font-body-family); font-weight: var(--font-body-weight); }
  h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading-family); font-weight: var(--font-heading-weight); }
  button, .btn { font-family: var(--font-body-family) !important; }
  .features_grid-item { font-family: var(--font-body-family); font-weight: var(--font-body-weight-bold); }
  .spice_banner-description { font-family: var(--font-body-family); font-weight: var(--font-body-weight); }

  b, strong { font-weight: var(--font-body-weight-bold); }

  h1, h2, .h0, .h1, .h2 {
    letter-spacing: -0.01em;
  }

  /* Eyebrow / small caps label, echoing "WELLNESS CO." in the logo */
  .gz-eyebrow {
    font-family: var(--font-body-family);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Italic accent for quotes and ingredient callouts (use at 2.2rem or larger) */
  .gz-accent {
    font-family: var(--gz-font-accent);
    font-style: italic;
    font-weight: 400;
  }
</style>
