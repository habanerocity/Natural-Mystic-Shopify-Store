{%- capture flickity_options -%}
    {
        "prevNextButtons": false,
        "autoPlay": 5000,
        "pauseAutoPlayOnHover": true,
        "contain": true,
        "pageDots": true,
        "cellAlign": "left",
        "groupCells": false
    }
{%- endcapture -%}
<section class="container slider-container py-5">
    <div class="featured-collection-slider page-width">
        {%- comment -%} Title left, arrows right: one control row above the cards at every screen size {%- endcomment -%}
        <div class="product-slider__header">
            {% if section.settings.title != blank %}
                <h1 class="dot product-slider__title">{{ section.settings.title | escape }}</h1>
            {% endif %}
            <div class="product-slider__nav" id="ProductSliderNav-{{ section.id }}" hidden>
                <button type="button" class="product-slider__arrow" data-dir="prev" aria-label="Previous products" aria-controls="ProductSlider-{{ section.id }}">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
                </button>
                <button type="button" class="product-slider__arrow" data-dir="next" aria-label="Next products" aria-controls="ProductSlider-{{ section.id }}">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>

        {%- assign collection = collections[section.settings.collection] -%}
        {%- assign product_limit = section.settings.product_count -%}


        <div class="products-carousel product-slider js-flickity" id="ProductSlider-{{ section.id }}" data-flickity='{{ flickity_options }}'>

            {% for product in collection.products limit: product_limit %}
                <div class="carousel-cell product-slider__cell">
                    {% render 'product-card', product: product %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
  (function () {
    // Every move is exactly one card: cards align left, and the repeated end
    // positions that "contain" leaves behind are merged, so next/prev never
    // stalls. Cards always start at the container's left edge, even when there
    // are too few to fill the row, so the slider lines up with the heading above.
    function setup() {
      var el = document.getElementById('ProductSlider-{{ section.id }}');
      if (!el || typeof Flickity === 'undefined') return;
      // The theme editor re-inserts sections after page load, when Flickity's auto-init has already run
      var flkty = Flickity.data(el) || new Flickity(el, JSON.parse(el.getAttribute('data-flickity')));

      var containSlides = flkty._containSlides;
      flkty._containSlides = function () {
        containSlides.call(this);
        var kept = [];
        this.slides.forEach(function (slide) {
          var prev = kept[kept.length - 1];
          if (prev && Math.abs(slide.target - prev.target) < 1) {
            prev.cells = prev.cells.concat(slide.cells);
          } else {
            kept.push(slide);
          }
        });
        this.slides = kept;
      };

      // Re-run the slide layout so the merge above applies to the initial render
      function relayout() {
        flkty.reloadCells();
        flkty.select(Math.min(flkty.selectedIndex, flkty.slides.length - 1), false, true);
        if (flkty.pageDots) flkty.updatePageDots();
        updateNav();
      }

      // Header arrows: hidden when everything fits, disabled at either end
      var nav = document.getElementById('ProductSliderNav-{{ section.id }}');
      var prevBtn = nav.querySelector('[data-dir="prev"]');
      var nextBtn = nav.querySelector('[data-dir="next"]');
      function updateNav() {
        nav.hidden = flkty.slides.length < 2;
        prevBtn.disabled = flkty.selectedIndex === 0;
        nextBtn.disabled = flkty.selectedIndex >= flkty.slides.length - 1;
      }
      prevBtn.addEventListener('click', function () { flkty.previous(); flkty.stopPlayer(); });
      nextBtn.addEventListener('click', function () { flkty.next(); flkty.stopPlayer(); });
      flkty.on('select', updateNav);

      // Equal-height cards: measure each card at its natural height, then give every cell the
      // tallest height. Re-run after the window settles from a resize and once images have loaded.
      function equalize() {
        flkty.cells.forEach(function (cell) { cell.element.style.minHeight = ''; });
        var tallest = flkty.cells.reduce(function (max, cell) { return Math.max(max, cell.element.offsetHeight); }, 0);
        flkty.cells.forEach(function (cell) { cell.element.style.minHeight = tallest + 'px'; });
        flkty.resize();
      }

      relayout();
      equalize();
      flkty.on('resize', updateNav);

      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(equalize, 200);
      });
      window.addEventListener('load', equalize);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 4,
      "max": 12,
      "label": "Number of products to display",
      "default": 4
    }
  ],
  "presets": [
    {
      "category": "Collection",
      "name": "Collection Slider",
      "settings": {}
    }
  ]
}
{% endschema %}