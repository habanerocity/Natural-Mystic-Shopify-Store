{%- comment -%}
  Related items. Shopify fills `recommendations` when this section is requested through
  /recommendations/products, so the page fetches it after load and swaps the result in.
{%- endcomment -%}
<div class="container product-recommendations" data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <section class="product-recommendations__inner">
            <h2 class="product-recommendations__title">{{ section.settings.heading }}</h2>
            <div class="row g-3 product-grid">
                {%- for recommendation in recommendations.products -%}
                    <div class="col-6 col-lg-3">
                        {% render 'product-card', product: recommendation %}
                    </div>
                {%- endfor -%}
            </div>
        </section>
    {%- endif -%}
</div>

<script>
    (function () {
        var holder = document.currentScript.previousElementSibling;
        if (!holder || !holder.dataset.recommendationsUrl) return;
        fetch(holder.dataset.recommendationsUrl)
            .then(function (res) { return res.text(); })
            .then(function (html) {
                var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('.product-recommendations');
                if (fresh && fresh.innerHTML.trim()) holder.innerHTML = fresh.innerHTML;
            })
            .catch(function () {});
    })();
</script>

{% schema %}
{
    "name": "Related items",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Related Items"
        },
        {
            "type": "range",
            "id": "products_to_show",
            "label": "Products to show",
            "min": 2,
            "max": 8,
            "step": 1,
            "default": 4
        }
    ]
}
{% endschema %}
