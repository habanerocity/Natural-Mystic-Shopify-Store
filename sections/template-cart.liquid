<div class="header_banner-cart position-relative text-center p-3 p-md-5">
    <div class="col-md-5 p-lg-5 mx-auto my-5">
        <h1 class="display-4 turmeric">{{ section.settings.banner_heading | default: "Cart" }}</h1>
        {% if section.settings.banner_subheading != blank %}
<p class="lead text-light">{{ section.settings.banner_subheading }}</p>
{% endif %}
    </div>
</div>
<div class="container my-5">
    {% if cart.item_count > 0 %}
        <div class="my-5">
            <form action="{{ routes.cart_url }}" class="row g-4" method="POST" novalidate data-cart-form>
                <div class="col-12 col-lg-8">
                    <div class="card cart-card">
                        <div class="card-body">
                            <div class="cart-lines">
                                <div class="cart-lines__head" aria-hidden="true">
                                    <span>Product</span>
                                    <span>Quantity</span>
                                    <span class="text-end">Total</span>
                                </div>
                                {% for item in cart.items %}
                                    <div class="cart-line" data-cart-line="{{ forloop.index }}">
                                        <a class="cart-line__image" href="{{ item.url }}">
                                            {% if item.image %}
                                                {% assign line_alt = item.image.alt | default: item.title | escape %}
                                                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: line_alt }}
                                            {% else %}
                                                <span class="cart-line__image-empty"></span>
                                            {% endif %}
                                        </a>

                                        <div class="cart-line__info">
                                            <a class="cart-line__title text-decoration-none dot" href="{{ item.url }}">{{ item.product.title }}</a>
                                            {% unless item.product.has_only_default_variant %}
                                                <p class="cart-line__variant">{{ item.variant.title }}</p>
                                            {% endunless %}
                                            <p class="cart-line__price">{{ item.price | money }}</p>
                                            <a class="cart-line__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" aria-label="Remove {{ item.product.title | escape }} from cart">
                                                {% if section.settings.delete_icon != blank %}
                                                    <img alt="" class="trash" src="{{ section.settings.delete_icon | image_url: width: 48 }}" width="15" height="15">
                                                {% else %}
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
                                                {% endif %}
                                                <span>Remove</span>
                                            </a>
                                        </div>

                                        <div class="cart-line__qty">
                                            <label class="visually-hidden" for="updates_{{ item.key }}">Quantity for {{ item.product.title | escape }}</label>
                                            {%- comment -%} Same pill stepper as the product page; changes save automatically (script below) {%- endcomment -%}
                                            <div class="pdp-qty cart-qty">
                                                <button type="button" class="pdp-qty__btn" data-cart-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">&minus;</button>
                                                <input class="pdp-qty__input" type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-qty>
                                                <button type="button" class="pdp-qty__btn" data-cart-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                                            </div>
                                        </div>

                                        <div class="cart-line__total">
                                            {% if item.original_line_price != item.line_price %}
                                                <s class="cart-line__was">{{ item.original_line_price | money }}</s>
                                            {% endif %}
                                            <span>{{ item.line_price | money }}</span>
                                            {% for discount in item.discounts %}
                                                <span class="cart-line__discount">{{ discount.title }}</span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="card cart-card price_card">
                        <div class="card-body">
                            {% for block in section.blocks %}
                                {% case block.type %}
                                    {% when "cart_total" %}
                                        <div class="cart-total-block" {{ block.shopify_attributes }}>
                                            <p class="h3">Your total:</p>
                                            <p class="cart-total-block__amount">{{ cart.total_price | money }}</p>
                                        </div>
                                    {% when "cart_checkout_button" %}
                                        <div class="cart-checkout-buttons d-grid gap-2" {{ block.shopify_attributes }}>
                                            <button class="btn rust cart-checkout" name="checkout" type="submit">Checkout</button>
                                            {%- if additional_checkout_buttons -%}
                                                <div class="cart-dynamic">{{ content_for_additional_checkout_buttons }}</div>
                                            {%- endif -%}
                                            {%- comment -%} Fallback for when the auto-update script can't run; the script hides it {%- endcomment -%}
                                            <button class="cart-update-link" name="update" type="submit" data-cart-update>Update cart</button>
                                            <p class="cart-status" role="status" aria-live="polite" data-cart-status></p>
                                        </div>
                                {% endcase %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </form>
        </div>
    {% else %}
        <div class="row">
            <h2 class="text-center">Your Cart is empty</h2>
        </div>
    {% endif %}
</div>

<script>
  (function () {
    // Quantity changes save on their own: the line is changed through Shopify's cart API, then this
    // section is re-rendered from the server so prices, discounts and totals are always Shopify's.
    // The "Update cart" button stays as a fallback and is hidden once this script runs.
    if (window.__gzCartInit) return;
    window.__gzCartInit = true;

    var sectionId = '{{ section.id }}';
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var queue = Promise.resolve();
    var timers = {};

    function section() { return document.getElementById('shopify-section-' + sectionId); }

    function prepare() {
      var el = section();
      if (!el) return;
      el.querySelectorAll('[data-cart-update]').forEach(function (b) { b.hidden = true; });
    }

    function setStatus(text, isError) {
      var status = section() && section().querySelector('[data-cart-status]');
      if (!status) return;
      status.textContent = text;
      status.classList.toggle('is-error', !!isError);
    }

    function render(focus) {
      return fetch(window.location.pathname + '?sections=' + sectionId)
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var html = new DOMParser().parseFromString(data[sectionId], 'text/html');
          var fresh = html.getElementById('shopify-section-' + sectionId);
          if (fresh) section().innerHTML = fresh.innerHTML;
          prepare();
          // Put focus back on the same control so keyboard users don't lose their place
          if (focus) {
            var target = section().querySelector('[data-cart-line="' + focus.line + '"] ' + focus.selector);
            if (target) target.focus();
          }
          if (typeof update_cart === 'function') update_cart();
        });
    }

    function save(line, quantity, focus) {
      queue = queue.then(function () {
        var row = section().querySelector('[data-cart-line="' + line + '"]');
        if (row) row.setAttribute('aria-busy', 'true');
        return fetch(root + 'cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ line: line, quantity: quantity })
        })
          .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
          .then(function (result) {
            return render(focus).then(function () {
              if (result.ok) setStatus('Cart updated');
              else setStatus(result.data.description || result.data.message || 'That quantity isn’t available.', true);
            });
          })
          .catch(function () {
            // Network trouble: fall back to the regular form so nothing is lost
            var update = section().querySelector('[data-cart-update]');
            if (update) { update.hidden = false; }
            setStatus('Couldn’t update the cart. Use “Update cart” to try again.', true);
          });
      });
    }

    // Wait briefly so several quick taps on + or - become one update
    function schedule(input, focusSelector) {
      var row = input.closest('[data-cart-line]');
      if (!row) return;
      var line = parseInt(row.getAttribute('data-cart-line'), 10);
      var quantity = Math.max(0, parseInt(input.value, 10) || 0);
      clearTimeout(timers[line]);
      timers[line] = setTimeout(function () { save(line, quantity, { line: line, selector: focusSelector }); }, 400);
    }

    document.addEventListener('click', function (e) {
      var step = e.target.closest('[data-cart-step]');
      if (!step || !section() || !section().contains(step)) return;
      var input = step.parentElement.querySelector('[data-cart-qty]');
      var next = Math.max(0, (parseInt(input.value, 10) || 0) + parseInt(step.getAttribute('data-cart-step'), 10));
      input.value = next;
      schedule(input, '[data-cart-step="' + step.getAttribute('data-cart-step') + '"]');
    });

    document.addEventListener('change', function (e) {
      var input = e.target.closest('[data-cart-qty]');
      if (!input || !section() || !section().contains(input)) return;
      schedule(input, '[data-cart-qty]');
    });

    // Enter in a quantity box saves that line instead of submitting the whole form
    document.addEventListener('keydown', function (e) {
      var input = e.target.closest && e.target.closest('[data-cart-qty]');
      if (!input || e.key !== 'Enter') return;
      e.preventDefault();
      schedule(input, '[data-cart-qty]');
    });

    prepare();
  })();
</script>

<style>
        .header_banner-cart {
            background: var(--banner-overlay), url({{ section.settings.banner_image | img_url: "master"}});
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            height: 100%;
            width: 100%;
        }

        @media screen and (max-width: 600px){
            .header_banner-cart {
            background: var(--banner-overlay), url({{ section.settings.banner_image-mobile | img_url: "master"}});
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            height: 100%;
            width: 100%;
        }
        }

        /* Cart lines: a flexible grid instead of a wide table, so nothing overflows the card */
        .cart-lines {
            min-width: 0;
        }

        .cart-lines__head {
            display: none;
        }

        .cart-line {
            display: grid;
            grid-template-columns: 4.5rem minmax(0, 1fr) auto;
            grid-template-areas:
                "image info info"
                "image qty total";
            gap: 0.75rem 1rem;
            align-items: center;
            padding: 1.1rem 0;
            border-top: 1px solid #ececec;
        }

        .cart-lines__head + .cart-line {
            border-top: 0;
            padding-top: 0;
        }

        .cart-line:last-child {
            padding-bottom: 0;
        }

        .cart-line__image {
            grid-area: image;
            align-self: start;
            display: block;
            aspect-ratio: 1 / 1;
            border-radius: 8px;
            background-color: #f6f5f3;
            overflow: hidden;
        }

        .cart-line__image img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cart-line__info {
            grid-area: info;
            min-width: 0;
        }

        .cart-line__info p {
            margin: 0;
        }

        .cart-line__title {
            display: block;
            font-weight: 600;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .cart-line__variant {
            margin-top: 0.15rem !important;
            font-size: 0.85rem;
            color: #6c757d;
        }

        .cart-line__price {
            margin-top: 0.25rem !important;
            font-size: 0.9rem;
        }

        .cart-line__remove {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            margin-top: 0.5rem;
            font-size: 0.8rem;
            color: #6c757d;
            text-decoration: none;
        }

        .cart-line__remove:hover {
            color: var(--bs-body-color);
            text-decoration: underline;
        }

        .cart-line__qty {
            grid-area: qty;
        }

        .cart-line__total {
            grid-area: total;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            font-weight: 600;
            white-space: nowrap;
        }

        .cart-line__was {
            font-weight: 400;
            font-size: 0.85rem;
            color: #6c757d;
        }

        .cart-line__discount {
            font-weight: 400;
            font-size: 0.75rem;
            color: var(--color-primary);
            white-space: normal;
            text-align: right;
        }

        /* Compact version of the product page's pill stepper */
        .cart-qty .pdp-qty__btn,
        .cart-qty .pdp-qty__input {
            height: 2.25rem;
        }

        .cart-qty .pdp-qty__btn {
            width: 2.25rem;
            font-size: 1.1rem;
        }

        .cart-qty .pdp-qty__input {
            width: 2.5rem;
            padding: 0;
        }

        /* Phones: full 44px tap targets */
        @media screen and (max-width: 575px) {
            .cart-qty .pdp-qty__btn,
            .cart-qty .pdp-qty__input {
                height: 2.75rem;
            }

            .cart-qty .pdp-qty__btn {
                width: 2.75rem;
            }
        }

        /* While a quantity change is saving */
        .cart-line[aria-busy="true"] {
            opacity: 0.55;
            transition: opacity .15s;
        }

        /* Light border and rounded corners like the product and collection cards, no heavy shadow */
        .cart-card {
            border: 1px solid #ececec;
            border-radius: 16px;
            box-shadow: none;
        }

        .cart-card > .card-body {
            padding: 1.5rem;
        }

        /* Shopify's express checkout buttons as pills, the same height as Checkout */
        .cart-dynamic {
            --shopify-accelerated-checkout-button-border-radius: 999px;
            --shopify-accelerated-checkout-button-block-size: 55px;
        }

        /* Only visible if the auto-update script can't run */
        .cart-update-link {
            justify-self: center;
            padding: 0.25rem;
            border: 0;
            background: none;
            font-size: 0.85rem;
            color: var(--color-text-muted);
            text-decoration: underline;
            text-underline-offset: 0.2em;
        }

        .cart-status {
            margin: 0;
            font-size: 0.85rem;
            color: var(--color-text-muted);
            text-align: center;
        }

        .cart-status:empty {
            display: none;
        }

        .cart-status.is-error {
            color: var(--color-alert);
        }

        .cart-total-block p {
            margin-bottom: 0.5rem;
        }

        .cart-total-block__amount {
            font-size: 1.6rem;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .price_card .cart-checkout-buttons {
            margin-top: 1rem;
        }

        /* Tablet and up: one row per item with real columns */
        @media screen and (min-width: 576px) {
            .cart-lines__head,
            .cart-line {
                grid-template-columns: 5rem minmax(0, 1fr) 7.5rem 7rem;
            }

            .cart-line {
                grid-template-areas: "image info qty total";
                gap: 1rem 1.25rem;
            }

            .cart-lines__head {
                display: grid;
                grid-template-columns: 5rem minmax(0, 1fr) 7.5rem 7rem;
                gap: 1rem 1.25rem;
                padding-bottom: 0.75rem;
                border-bottom: 1px solid #ececec;
                font-size: 0.8rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: #6c757d;
            }

            .cart-lines__head span:first-child {
                grid-column: 1 / 3;
            }

            .cart-lines__head + .cart-line {
                padding-top: 1.1rem;
            }
        }

        /* Keep the summary in view on wide screens while the list scrolls */
        @media screen and (min-width: 992px) {
            .price_card {
                position: sticky;
                top: 6rem;
            }
        }
    </style>

{% schema %}
{
        "name": "Template Cart",
        "tag": "section",
        "blocks": [
        {
            "type": "cart_total",
            "name": "Cart Total",
            "limit": 1
        },
        {
            "type": "cart_checkout_button",
            "name": "Cart Buttons",
            "limit": 1
        },
        {
            "type": "title",
            "name": "Title",
            "limit": 1
        }
        ],
        "settings": [
        {
            "type": "image_picker",
            "id": "banner_image",
            "label": "Heading Background Image"
        },
        {
            "type": "image_picker",
            "id": "banner_image-mobile",
            "label": "Mobile Heading Background Image"
        },
{
"type": "text",
"id": "banner_heading",
"label": "Heading",
"info": "Leave blank to use \"Cart\"."
},
{
"type": "text",
"id": "banner_subheading",
"label": "Subheading",
"info": "Leave blank to hide.",
"default": "Online Checkout"
},
        {
            "type": "image_picker",
            "id": "delete_icon",
            "label": "Delete icon"
        }
        ]
    }
{% endschema %}