<style>
                .header_banner-collection {
                    background: var(--banner-overlay), url({{ collection.image | img_url: "master"}});
                    background-repeat: no-repeat;
                    background-position: center center;
                    background-size: cover;
                    /* height: 100%; */
                    width: 100%;
                }
            
                .header_banner-shop{
                    background-image: var(--banner-overlay), url({{ section.settings.banner_image | img_url: "master"}});
                    background-repeat: no-repeat;
                    background-position: center center;
                    background-size: cover;
                    /* height: 100%; */
                    width: 100%;
                }

                @media screen and (max-width: 600px){
                    .header_banner-shop{
                    background-image: var(--banner-overlay), url({{ section.settings.banner_image-mobile | img_url: "master"}});
                    background-repeat: no-repeat;
                    background-position: center center;
                    background-size: cover;
                    /* height: 100%; */
                    width: 100%;
                }
                }
            </style>

{% schema %}
{
                "name": "Page settings",
                "settings": [
                {
                    "type": "image_picker",
                    "id": "banner_image",
                    "label": "Heading Background Image"
                },
                {
                    "type": "image_picker",
                    "id": "banner_image-mobile",
                    "label": "Mobile Heading Background Image"
                },
{
"type": "text",
"id": "banner_heading",
"label": "Heading",
"info": "Leave blank to use the collection title."
},
{
"type": "text",
"id": "banner_subheading",
"label": "Subheading",
"info": "Leave blank to use the collection description (or the default text on the all-products page)."
}
                ]
            }
{% endschema %}