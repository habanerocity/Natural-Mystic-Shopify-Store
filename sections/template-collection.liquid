<style>
                .header_banner-collection {
                    background: var(--banner-overlay), url({{ collection.image | img_url: "master"}});
                    background-repeat: no-repeat;
                    background-position: center center;
                    background-size: cover;
                    /* height: 100%; */
                    width: 100%;
                }
            
                .header_banner-shop{
                    background-image: var(--banner-overlay), url({{ section.settings.banner_image | img_url: "master"}});
                    background-repeat: no-repeat;
                    background-position: center center;
                    background-size: cover;
                    /* height: 100%; */
                    width: 100%;
                }

                @media screen and (max-width: 600px){
                    .header_banner-shop{
                    background-image: var(--banner-overlay), url({{ section.settings.banner_image-mobile | img_url: "master"}});
                    background-repeat: no-repeat;
                    background-position: center center;
                    background-size: cover;
                    /* height: 100%; */
                    width: 100%;
                }
                }
            </style>

{% schema %}
{
                "name": "Page settings",
                "settings": [
                {
                    "type": "image_picker",
                    "id": "banner_image",
                    "label": "Heading Background Image",
                    "info": "Used when a collection has no image of its own. Set a collection image under Products > Collections."
                },
                {
                    "type": "image_picker",
                    "id": "banner_image-mobile",
                    "label": "Mobile Heading Background Image"
                },
{
"type": "text",
"id": "banner_heading",
"label": "All products heading",
"info": "Only used on the All products page (/collections/all). Other collections show their own title."
},
{
"type": "text",
"id": "banner_subheading",
"label": "All products subheading",
"info": "Only used on the All products page. Other collections show their own description (Products > Collections), or nothing if it's empty."
}
                ]
            }
{% endschema %}