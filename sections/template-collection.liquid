    {%- comment -%}
      Every collection shares this template, so the editor's heading/subheading only apply to the
      All products page (/collections/all). Other collections use their own title and description.
    {%- endcomment -%}
    {%- liquid
      assign is_catalog = false
      if collection.handle == 'all'
        assign is_catalog = true
      endif

      assign banner_title = collection.title
      if is_catalog and section.settings.banner_heading != blank
        assign banner_title = section.settings.banner_heading
      endif

      assign banner_text = collection.description | strip_html | strip
      if is_catalog and section.settings.banner_subheading != blank
        assign banner_text = section.settings.banner_subheading
      endif

      assign banner_class = 'header_banner-shop'
      if collection.image != blank
        assign banner_class = 'header_banner-collection'
      endif
    -%}
    <div class="{{ banner_class }} position-relative text-center p-3 p-md-5">
        <div class="col-md-5 p-lg-5 mx-auto my-5">
            <h1 class="display-4 turmeric">{{ banner_title | escape }}</h1>
            {%- if banner_text != blank -%}
                <p class="lead text-light">{{ banner_text | escape }}</p>
            {%- endif -%}
        </div>
    </div>
    <div class="container">
        <div class="my-3">
            {% if settings.show_breadcrumb_nav %}
                {% include 'breadcrumbs' %}
            {% endif %}
        </div>
        {%- assign active_filter_count = 0 -%}
        {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                    {%- assign active_filter_count = active_filter_count | plus: 1 -%}
                {%- endif -%}
            {%- else -%}
                {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}
            {%- endif -%}
        {%- endfor -%}
        {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
        {%- capture clear_filters_url -%}{{ collection.url }}?sort_by={{ current_sort }}{%- endcapture -%}

        <div class="collection-toolbar">
            <div class="collection-toolbar__start">
                {% if collection.filters.size > 0 %}
                    <button type="button" class="collection-pill" data-bs-toggle="offcanvas" data-bs-target="#CollectionFilters" aria-controls="CollectionFilters">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16l-6 7.5V19l-4 1.5v-8z"/></svg>
                        <span>Filters</span>
                        {% if active_filter_count > 0 %}<span class="collection-pill__count" aria-label="{{ active_filter_count }} active">{{ active_filter_count }}</span>{% endif %}
                    </button>
                {% endif %}
                <p class="collection-toolbar__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
            </div>

            <div class="collection-toolbar__end">
                <div class="collection-sort">
                    <label for="sort_by" class="collection-toolbar__label">Sort by</label>
                    <div class="collection-select">
                        <select id="sort_by" name="sort_by">
                            {% for option in collection.sort_options %}
                                <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>
                            {% endfor %}
                        </select>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
                    </div>
                </div>

                <div class="collection-view" role="group" aria-label="Grid layout">
                    <span class="collection-toolbar__label">View as</span>
                    <button type="button" class="collection-view__btn" data-grid-view="large" aria-pressed="false" aria-label="Larger product cards" title="Larger cards">
                        <svg class="collection-view__icon collection-view__icon--sm" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="3.00" y="3.00" width="18.00" height="8.00" rx="1.60"/><rect x="3.00" y="13.00" width="18.00" height="8.00" rx="1.60"/></svg><svg class="collection-view__icon collection-view__icon--md" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="3.00" y="3.00" width="8.00" height="8.00" rx="1.60"/><rect x="13.00" y="3.00" width="8.00" height="8.00" rx="1.60"/><rect x="3.00" y="13.00" width="8.00" height="8.00" rx="1.60"/><rect x="13.00" y="13.00" width="8.00" height="8.00" rx="1.60"/></svg><svg class="collection-view__icon collection-view__icon--lg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="3.00" y="6.33" width="4.67" height="4.67" rx="1.17"/><rect x="9.67" y="6.33" width="4.67" height="4.67" rx="1.17"/><rect x="16.33" y="6.33" width="4.67" height="4.67" rx="1.17"/><rect x="3.00" y="13.00" width="4.67" height="4.67" rx="1.17"/><rect x="9.67" y="13.00" width="4.67" height="4.67" rx="1.17"/><rect x="16.33" y="13.00" width="4.67" height="4.67" rx="1.17"/></svg>
                    </button>
                    <button type="button" class="collection-view__btn" data-grid-view="compact" aria-pressed="true" aria-label="More products per row" title="More per row">
                        <svg class="collection-view__icon collection-view__icon--sm" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="3.00" y="3.00" width="8.00" height="8.00" rx="1.60"/><rect x="13.00" y="3.00" width="8.00" height="8.00" rx="1.60"/><rect x="3.00" y="13.00" width="8.00" height="8.00" rx="1.60"/><rect x="13.00" y="13.00" width="8.00" height="8.00" rx="1.60"/></svg><svg class="collection-view__icon collection-view__icon--md" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="3.00" y="6.33" width="4.67" height="4.67" rx="1.17"/><rect x="9.67" y="6.33" width="4.67" height="4.67" rx="1.17"/><rect x="16.33" y="6.33" width="4.67" height="4.67" rx="1.17"/><rect x="3.00" y="13.00" width="4.67" height="4.67" rx="1.17"/><rect x="9.67" y="13.00" width="4.67" height="4.67" rx="1.17"/><rect x="16.33" y="13.00" width="4.67" height="4.67" rx="1.17"/></svg><svg class="collection-view__icon collection-view__icon--lg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="3.00" y="7.90" width="3.30" height="3.30" rx="0.82"/><rect x="7.90" y="7.90" width="3.30" height="3.30" rx="0.82"/><rect x="12.80" y="7.90" width="3.30" height="3.30" rx="0.82"/><rect x="17.70" y="7.90" width="3.30" height="3.30" rx="0.82"/><rect x="3.00" y="12.80" width="3.30" height="3.30" rx="0.82"/><rect x="7.90" y="12.80" width="3.30" height="3.30" rx="0.82"/><rect x="12.80" y="12.80" width="3.30" height="3.30" rx="0.82"/><rect x="17.70" y="12.80" width="3.30" height="3.30" rx="0.82"/></svg>
                    </button>
                </div>
            </div>
        </div>

        {% if active_filter_count > 0 %}
            <div class="collection-active-filters" aria-label="Active filters">
                {% for filter in collection.filters %}
                    {% if filter.type == 'price_range' %}
                        {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                            <a class="collection-chip" href="{{ filter.url_to_remove }}" aria-label="Remove price filter">
                                {{ filter.min_value.value | default: 0 | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }}
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
                            </a>
                        {% endif %}
                    {% else %}
                        {% for value in filter.active_values %}
                            <a class="collection-chip" href="{{ value.url_to_remove }}" aria-label="Remove filter: {{ filter.label | escape }} {{ value.label | escape }}">
                                {{ value.label }}
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
                            </a>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                <a class="collection-clear" href="{{ clear_filters_url }}">Clear all</a>
            </div>
        {% endif %}

        <div class="row g-3 product-grid collection-grid" id="ProductGrid" data-view="compact">
            <script>
                try {
                    var savedView = localStorage.getItem('collectionGridView');
                    if (savedView === 'large' || savedView === 'compact') document.getElementById('ProductGrid').setAttribute('data-view', savedView);
                } catch (e) {}
            </script>
            {% for product in collection.products %}
                <div class="col-6 col-sm-4 col-lg-3">
                    {% render 'product-card', product: product %}
                </div>

            {% else %}
                <div class="col-12 collection-empty">
                    {% if active_filter_count > 0 %}
                        <p class="collection-empty__title">No products match these filters</p>
                        <p>Try removing a filter or two.</p>
                        <a class="btn rust pdp-add collection-empty__btn" href="{{ clear_filters_url }}">Clear all filters</a>
                    {% else %}
                        <p class="collection-empty__title">This collection is empty</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <!-- creating a parameter and passing paginate variable here -->
        {% render 'pagination', paginate: paginate %}

    {% endpaginate %}
</div>

{% if collection.filters.size > 0 %}
    {%- assign drawer_sort = collection.sort_by | default: collection.default_sort_by -%}
    <div class="offcanvas offcanvas-start collection-filters" tabindex="-1" id="CollectionFilters" aria-labelledby="CollectionFiltersLabel">
        <form action="{{ collection.url }}" method="get" class="collection-filters__form" data-collection-filters>
            <input type="hidden" name="sort_by" value="{{ drawer_sort }}">
            <div class="collection-filters__header">
                <h2 class="collection-filters__title" id="CollectionFiltersLabel">Filters</h2>
                <button type="button" class="quickview__close collection-filters__close" data-bs-dismiss="offcanvas" aria-label="Close filters">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>

            <div class="collection-filters__body">
                {% for filter in collection.filters %}
                    {%- assign group_active = filter.active_values.size -%}
                    {%- if filter.type == 'price_range' -%}
                        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign group_active = 1 -%}{%- endif -%}
                    {%- endif -%}
                    <details class="collection-filter" {% if group_active > 0 or forloop.index <= 2 %}open{% endif %}>
                        <summary>
                            <span>{{ filter.label }}{% if group_active > 0 and filter.type != 'price_range' %} <span class="collection-filter__badge">{{ group_active }}</span>{% endif %}</span>
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
                        </summary>

                        {% if filter.type == 'price_range' %}
                            <div class="collection-price">
                                <label class="collection-price__field">
                                    <span class="collection-price__label">From</span>
                                    <span class="collection-price__input">
                                        <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                                        <input type="number" name="{{ filter.min_value.param_name }}" inputmode="decimal" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" step="0.01" placeholder="0" {% if filter.min_value.value != nil %}value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %}>
                                    </span>
                                </label>
                                <label class="collection-price__field">
                                    <span class="collection-price__label">To</span>
                                    <span class="collection-price__input">
                                        <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                                        <input type="number" name="{{ filter.max_value.param_name }}" inputmode="decimal" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" step="0.01" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" {% if filter.max_value.value != nil %}value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %}>
                                    </span>
                                </label>
                            </div>
                            <p class="collection-filter__hint">The highest price is {{ filter.range_max | money }}</p>
                        {% else %}
                            <ul class="collection-filter__list">
                                {% for value in filter.values %}
                                    {%- assign is_empty = false -%}
                                    {%- if value.count == 0 and value.active == false -%}{%- assign is_empty = true -%}{%- endif -%}
                                    <li>
                                        <label class="collection-check{% if is_empty %} is-disabled{% endif %}">
                                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if is_empty %}disabled{% endif %}>
                                            <span class="collection-check__box" aria-hidden="true"></span>
                                            <span class="collection-check__label">{{ value.label }}</span>
                                            <span class="collection-check__count">{{ value.count }}</span>
                                        </label>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </details>
                {% endfor %}
            </div>

            <div class="collection-filters__footer">
                <a class="collection-clear" href="{{ collection.url }}?sort_by={{ drawer_sort }}">Clear all</a>
                <button type="submit" class="btn rust pdp-add collection-filters__apply">Show results</button>
            </div>
        </form>
    </div>
{% endif %}

<div class="modal fade quickview" id="productInfoModal" tabindex="-1" aria-labelledby="quickviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable quickview__dialog">
        <div class="modal-content quickview__content">
            <button aria-label="Close" class="quickview__close" data-bs-dismiss="modal" type="button">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
            <div class="modal-body quickview__body">
                <div class="quickview__gallery" data-quickview-gallery>
                    <div class="quickview__main" data-quickview-main>
                        <button type="button" class="quickview__nav quickview__nav--prev" data-quickview-step="-1" aria-label="Previous image" hidden>
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <button type="button" class="quickview__nav quickview__nav--next" data-quickview-step="1" aria-label="Next image" hidden>
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <span class="quickview__counter" aria-live="polite" data-quickview-counter hidden></span>
                    </div>
                    <div class="quickview__thumbs" role="list" aria-label="Product images" data-quickview-thumbs></div>
                </div>

                <div class="quickview__info">
                    <h2 class="quickview__title" id="quickviewTitle" data-quickview-title></h2>
                    <div class="quickview__price">
                        <span class="quickview__price-current" data-quickview-price></span>
                        <s class="quickview__price-compare" data-quickview-compare hidden></s>
                        <span class="quickview__badge" data-quickview-badge hidden>Sale</span>
                    </div>
                    <p class="quickview__description" data-quickview-description></p>

                    <form action="{{ routes.cart_add_url }}" method="post" class="quickview__form" id="addToCartForm">
                        <input type="hidden" name="id" value="" data-quickview-variant-id>
                        <div class="pdp-options" data-quickview-options></div>

                        <div class="quickview__field">
                            <label for="modalItemQuantity" class="pdp-label">Quantity</label>
                            <div class="pdp-qty">
                                <button type="button" class="pdp-qty__btn" data-quickview-qty="-1" aria-label="Decrease quantity">&minus;</button>
                                <input class="pdp-qty__input" id="modalItemQuantity" name="quantity" type="number" value="1" min="1" inputmode="numeric">
                                <button type="button" class="pdp-qty__btn" data-quickview-qty="1" aria-label="Increase quantity">+</button>
                            </div>
                        </div>

                        <div class="pdp-buy">
                            <button class="btn rust pdp-add" id="AddToCart" name="add" type="submit" data-quickview-add>Add to cart</button>
                            {%- if settings.enable_wishlist -%}
                            <div class="pdp-wishlist" role="button" tabindex="0" aria-pressed="false" aria-label="Add to wishlist" data-quickview-wishlist>
                                <div class="swym-button swym-add-to-wishlist heart__beat" data-with-epi="true" data-swaction="addToWishlist" data-product-id="" data-variant-id="" data-product-url=""></div>
                            </div>
                            {%- endif -%}
                        </div>

                        <p class="quickview__status" role="status" aria-live="polite" data-quickview-status></p>
                        <a class="quickview__details" href="#" data-quickview-link>View full details <span aria-hidden="true">&rarr;</span></a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

