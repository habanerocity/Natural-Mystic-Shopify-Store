<section class="container py-4">
    <h2 class="text-center my-3">{{ section.settings.title }}</h2>
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 product-grid">
        {% for product in collections[section.settings.featured_collection].products limit: 8 %}
            <div class="col">
                {% render 'product-card', product: product %}
            </div>
        {% endfor %}
    </div>
</section>


{% schema %}
{
    "name": "Featured Collection",
    "class": "featured-collection-section",
    "settings": [
          { 
           "type": "collection",
            "id": "featured_collection",
            "label": "Collection"
          },
          {
              "type": "text",
              "id": "title",
              "default": "Featured Collection",
              "label": "Title"
          }
    ],
    "presets": [
        {
            "category": "Collection",
            "name": "Featured Collection"
        }
    ]
}
{% endschema %}