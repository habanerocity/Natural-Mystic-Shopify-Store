<script>
    (function () {
        var root = document.getElementById('ProductSection-{{ section.id }}');
        if (!root) return;

        var variants = JSON.parse(root.querySelector('[data-variant-json]').textContent);
        var slides = root.querySelectorAll('[data-media-id]');
        var thumbs = root.querySelectorAll('[data-thumb-for]');
        var idInput = root.querySelector('[data-variant-id-input]');
        var priceEl = root.querySelector('[data-price]');
        var compareEl = root.querySelector('[data-compare-price]');
        var badgeEl = root.querySelector('[data-sale-badge]');
        var addButton = root.querySelector('[data-add-button]');
        var qtyInput = root.querySelector('#Quantity');

        var counter = root.querySelector('[data-gallery-counter]');
        var thumbStrip = root.querySelector('.pdp-gallery__thumbs');

        function currentIndex() {
            for (var i = 0; i < slides.length; i++) {
                if (slides[i].classList.contains('is-active')) return i;
            }
            return 0;
        }

        function updateCounter() {
            if (counter) counter.textContent = (currentIndex() + 1) + ' / ' + slides.length;
        }

        function showMedia(mediaId) {
            if (!mediaId || !root.querySelector('[data-media-id="' + mediaId + '"]')) return;
            slides.forEach(function (slide) {
                var active = slide.getAttribute('data-media-id') === String(mediaId);
                slide.classList.toggle('is-active', active);
                if (active) {
                    slide.removeAttribute('aria-hidden');
                } else {
                    slide.setAttribute('aria-hidden', 'true');
                }
            });
            thumbs.forEach(function (thumb) {
                if (thumb.getAttribute('data-thumb-for') === String(mediaId)) {
                    thumb.setAttribute('aria-current', 'true');
                    // Keep the active thumbnail visible without scrolling the page
                    if (thumbStrip) {
                        thumbStrip.scrollTo({ left: thumb.offsetLeft - thumbStrip.offsetLeft - 16, behavior: 'smooth' });
                    }
                } else {
                    thumb.removeAttribute('aria-current');
                }
            });
            updateCounter();
        }

        function step(direction) {
            if (slides.length < 2) return;
            var next = (currentIndex() + direction + slides.length) % slides.length;
            showMedia(slides[next].getAttribute('data-media-id'));
        }

        thumbs.forEach(function (thumb) {
            thumb.addEventListener('click', function () {
                showMedia(thumb.getAttribute('data-thumb-for'));
            });
        });

        root.querySelectorAll('[data-gallery-step]').forEach(function (button) {
            button.addEventListener('click', function () {
                step(parseInt(button.getAttribute('data-gallery-step'), 10));
            });
        });

        var gallery = root.querySelector('.pdp-gallery');
        if (gallery) {
            // Arrow keys while focus is anywhere in the gallery
            gallery.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
                if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
            });
        }

        var mainFrame = root.querySelector('.pdp-gallery__main');
        if (mainFrame) {
            // Swipe left/right on touch screens
            var touchStartX = null;
            mainFrame.addEventListener('touchstart', function (e) {
                touchStartX = e.touches[0].clientX;
            }, { passive: true });
            mainFrame.addEventListener('touchend', function (e) {
                if (touchStartX === null) return;
                var deltaX = e.changedTouches[0].clientX - touchStartX;
                if (Math.abs(deltaX) > 40) step(deltaX < 0 ? 1 : -1);
                touchStartX = null;
            });
        }

        updateCounter();

        var wishlistButton = root.querySelector('[data-wishlist-button]');
        var wishlistHeart = wishlistButton && wishlistButton.querySelector('.swym-button');

        if (wishlistButton && wishlistHeart) {
            // The wishlist app listens on the heart itself, so pass clicks on the larger square through to it
            wishlistButton.addEventListener('click', function (e) {
                if (!wishlistHeart.contains(e.target)) wishlistHeart.click();
            });
            wishlistButton.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    wishlistHeart.click();
                }
            });

            // Reflect the app's "liked" state for assistive tech
            var syncWishlistState = function () {
                var liked = wishlistHeart.classList.contains('liked');
                wishlistButton.setAttribute('aria-pressed', liked ? 'true' : 'false');
                wishlistButton.setAttribute('aria-label', liked ? 'Remove from wishlist' : 'Add to wishlist');
            };
            new MutationObserver(syncWishlistState).observe(wishlistHeart, { attributes: true, attributeFilter: ['class'] });
            syncWishlistState();
        }

        var optionGroups = root.querySelectorAll('[data-option-index]');
        var planData = JSON.parse((root.querySelector('[data-plan-json]') || { textContent: '{}' }).textContent || '{}');
        var sellingPlanInput = root.querySelector('[data-selling-plan-input]');
        var planSelect = root.querySelector('[data-plan-select]');
        var purchaseInputs = root.querySelectorAll('[data-purchase-input]');
        var purchaseCards = root.querySelectorAll('[data-purchase-card]');
        var planPriceEl = root.querySelector('[data-plan-price]');
        var planCompareEl = root.querySelector('[data-plan-compare]');
        var planBadgeEl = root.querySelector('[data-plan-badge]');
        var oneTimePriceEl = root.querySelector('[data-onetime-price]');
        var oneTimeCompareEl = root.querySelector('[data-onetime-compare]');

        function selectedOptions() {
            return Array.prototype.map.call(optionGroups, function (group) {
                var checked = group.querySelector('[data-option-input]:checked');
                return checked ? checked.value : null;
            });
        }

        function findVariant(options) {
            return variants.find(function (v) {
                return v.options.every(function (value, i) { return options[i] == null || value === options[i]; });
            });
        }

        function currentVariant() {
            if (!optionGroups.length) {
                return variants.find(function (v) { return String(v.id) === idInput.value; }) || variants[0];
            }
            return findVariant(selectedOptions());
        }

        // Strike through option values that have no available variant with the other current choices
        function markAvailability() {
            var selected = selectedOptions();
            optionGroups.forEach(function (group, index) {
                group.querySelectorAll('[data-option-input]').forEach(function (input) {
                    var options = selected.slice();
                    options[index] = input.value;
                    var match = findVariant(options);
                    var label = root.querySelector('label[for="' + input.id + '"]');
                    if (label) label.classList.toggle('is-unavailable', !match || !match.available);
                });
            });
        }

        function setText(el, html) {
            if (!el) return;
            el.innerHTML = html || '';
            el.hidden = !html;
        }

        function updatePurchaseOptions(variant) {
            if (!purchaseCards.length) return;

            var checked = root.querySelector('[data-purchase-input]:checked');
            var subscribe = checked && checked.value === 'subscription';
            var planId = planSelect ? planSelect.value : (sellingPlanInput && sellingPlanInput.value);
            var allocation = variant && variant.plans ? variant.plans[planId] : null;

            if (allocation) {
                if (planPriceEl) planPriceEl.innerHTML = allocation.price;
                setText(planCompareEl, allocation.compare);
            }
            setText(planBadgeEl, planData[planId] ? planData[planId].badge : null);

            if (variant) {
                if (oneTimePriceEl) oneTimePriceEl.innerHTML = variant.price;
                setText(oneTimeCompareEl, variant.compare);
            }

            if (sellingPlanInput) {
                sellingPlanInput.value = planId || '';
                // A disabled input isn't submitted, so one-time purchases don't send a selling plan
                sellingPlanInput.disabled = !subscribe || !allocation;
            }

            purchaseCards.forEach(function (card) {
                var input = card.querySelector('[data-purchase-input]');
                card.classList.toggle('is-selected', !!(input && input.checked));
            });
        }

        function onVariantChange() {
            var variant = currentVariant();
            markAvailability();

            if (!variant) {
                if (addButton) {
                    addButton.disabled = true;
                    addButton.textContent = 'Unavailable';
                }
                return;
            }

            idInput.value = variant.id;
            if (wishlistHeart) wishlistHeart.setAttribute('data-variant-id', variant.id);

            if (priceEl) {
                priceEl.innerHTML = variant.price;
                priceEl.classList.toggle('is-sale', !!variant.compare);
            }
            setText(compareEl, variant.compare);
            if (badgeEl) badgeEl.hidden = !variant.compare;

            if (addButton) {
                addButton.disabled = !variant.available;
                addButton.textContent = variant.available ? 'Add to cart' : 'Sold out';
            }

            updatePurchaseOptions(variant);
            showMedia(variant.media);

            var url = new URL(window.location.href);
            url.searchParams.set('variant', variant.id);
            window.history.replaceState({}, '', url.toString());
        }

        optionGroups.forEach(function (group) {
            group.addEventListener('change', onVariantChange);
        });

        purchaseInputs.forEach(function (input) {
            input.addEventListener('change', function () { updatePurchaseOptions(currentVariant()); });
        });

        if (planSelect) {
            planSelect.addEventListener('change', function () {
                // Choosing a frequency also chooses the subscription option
                var subscribeInput = root.querySelector('[data-purchase-input][value="subscription"]');
                if (subscribeInput) subscribeInput.checked = true;
                updatePurchaseOptions(currentVariant());
            });
        }

        markAvailability();
        updatePurchaseOptions(currentVariant());

        root.querySelectorAll('[data-qty-step]').forEach(function (button) {
            button.addEventListener('click', function () {
                if (!qtyInput) return;
                var next = (parseInt(qtyInput.value, 10) || 1) + parseInt(button.getAttribute('data-qty-step'), 10);
                qtyInput.value = Math.max(1, next);
            });
        });
    })();
</script>

