{%- comment -%}
  Product reviews area. Holds app blocks, so a reviews app (Judge.me, Loox, etc.) can put its
  review list and "write a review" form here. Add the app's widget block in the theme editor:
  Product page > Reviews > Add block.
{%- endcomment -%}
<section class="container product-reviews" id="reviews" aria-labelledby="ProductReviewsHeading-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
        <h2 class="product-reviews__title" id="ProductReviewsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
        {% render block %}
    {%- else -%}
        {%- if request.design_mode -%}
            <p class="product-reviews__empty">No reviews widget yet. Click <strong>Add block</strong> and choose your reviews app (for example Judge.me Review Widget).</p>
        {%- endif -%}
    {%- endfor -%}
</section>

<style>
    .product-reviews {
        padding-block: 3rem;
        border-top: 1px solid #ececec;
    }

    .product-reviews__empty {
        padding: 1.5rem;
        border: 1px dashed #c9c9c9;
        border-radius: 12px;
        color: #666;
        text-align: center;
    }

    /* Judge.me caps its widget at 1200px with 48px side margins (max 1200 in its block
       settings), which centers it inside the container. Let it fill the container instead,
       so its edges line up with the rest of the page. */
    .product-reviews .jdgm-widget {
        max-width: none !important;
        margin-inline: 0 !important;
    }

    /* The widget's own "Customer Reviews" title is styled with the other section headings in application.css */

    /* With no widget added, nothing shows to shoppers: hide the whole area */
    .product-reviews:not(:has(*:not(h2))) { display: none; }
</style>

{% schema %}
{
    "name": "Reviews",
    "tag": "div",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Customer reviews",
            "info": "Leave blank when your reviews app shows its own title (Judge.me does)."
        }
    ],
    "blocks": [
        {
            "type": "@app"
        }
    ],
    "presets": [
        {
            "name": "Reviews"
        }
    ]
}
{% endschema %}
