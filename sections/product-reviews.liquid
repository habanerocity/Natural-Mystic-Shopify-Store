{%- comment -%}
  Product reviews area. Holds app blocks, so a reviews app (Judge.me, Loox, etc.) can put its
  review list and "write a review" form here. Add the app's widget block in the theme editor:
  Product page > Reviews > Add block.
{%- endcomment -%}
<section class="container product-reviews" id="reviews" aria-labelledby="ProductReviewsHeading-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
        <h2 class="product-reviews__title" id="ProductReviewsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
        {% render block %}
    {%- else -%}
        {%- if request.design_mode -%}
            <p class="product-reviews__empty">No reviews widget yet. Click <strong>Add block</strong> and choose your reviews app (for example Judge.me Review Widget).</p>
        {%- endif -%}
    {%- endfor -%}
</section>

<style>
    .product-reviews {
        padding-block: 3rem;
        border-top: 1px solid #ececec;
    }

    .product-reviews__title {
        margin: 0 0 1.5rem;
        font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
        font-weight: 600;
        line-height: 1.15;
        color: var(--color-primary);
    }

    .product-reviews__empty {
        padding: 1.5rem;
        border: 1px dashed #c9c9c9;
        border-radius: 12px;
        color: #666;
        text-align: center;
    }

    /* With no widget added, nothing shows to shoppers: hide the whole area */
    .product-reviews:not(:has(*:not(h2))) { display: none; }
</style>

{% schema %}
{
    "name": "Reviews",
    "tag": "div",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Customer reviews"
        }
    ],
    "blocks": [
        {
            "type": "@app"
        }
    ],
    "presets": [
        {
            "name": "Reviews"
        }
    ]
}
{% endschema %}
