{%- liquid
  assign use_latest = false
  if section.settings.source == 'latest'
    assign use_latest = true
    assign source_blog = section.settings.blog
    # Shopify's blogs object can only be looked up by handle, not looped over,
    # so with no blog picked fall back to the default "news" blog.
    if source_blog == blank
      assign source_blog = blogs['news']
    endif
    assign posts = source_blog.articles
  endif
-%}

<div class="container py-3">
    {%- if section.settings.title != blank -%}
        <h1 class="dot text-center mb-5">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    <div class="blog_grid">
        {%- for slot in (1..3) -%}
            {%- liquid
              assign idx = slot | minus: 1
              assign article = null
              if use_latest
                assign article = posts[idx]
              endif

              if article != blank
                assign slot_image = article.image
                assign slot_link = article.url
                assign slot_title = article.title
                assign slot_text = article.excerpt_or_content | strip_html | strip | truncatewords: 14
              else
                assign image_key = 'image_' | append: slot
                assign link_key = 'hover_link_' | append: slot
                assign title_key = 'hover_title_' | append: slot
                assign text_key = 'hover_paragraph_' | append: slot
                assign slot_image = section.settings[image_key]
                assign slot_link = section.settings[link_key]
                assign slot_title = section.settings[title_key]
                assign slot_text = section.settings[text_key]
              endif
              assign slot_width = 1000
              if slot == 1
                assign slot_width = 1400
              endif
            -%}
            <div class="blog_grid_child-{{ slot }}">
                {%- if slot_image != blank -%}
                    <a href="{{ slot_link | default: '#' }}">
                        <figure class="snip0015 rounded grid_img">
                            {{ slot_image | image_url: width: slot_width | image_tag: class: 'rounded grid_img', loading: 'lazy', widths: '500, 800, 1000, 1400', sizes: '(min-width: 1200px) 600px, 50vw', alt: slot_image.alt | default: slot_title }}
                            <figcaption class="d-flex flex-column justify-content-center align-items-center">
                                <h2>{{ slot_title | escape }}</h2>
                                <p>{{ slot_text | escape }}</p>
                                <p class="blog-grid__cta rounded mt-2">View Here</p>
                            </figcaption>
                        </figure>
                    </a>
                {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
            </div>
        {%- endfor -%}
    </div>
</div>

<style>

    .p-1-half {
        padding: .3rem;
    }

    /* "View Here" pill shown on image hover: theme primary color, darker when the pill itself is hovered */
    .blog-grid__cta {
        padding: .3rem .75rem;
        background-color: var(--color-primary);
        color: #fff;
        transition: background-color .2s ease;
    }

    figure.snip0015 .blog-grid__cta:hover {
        background-color: var(--color-primary-dark);
    }

    /* Fixed-shape grid: one tall image left, two stacked right. Images crop to fill
       their cells, so any photo proportions keep the edges aligned. */
    .blog_grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "pic-1 pic-2"
        "pic-1 pic-3";
      gap: 1.25rem;
      aspect-ratio: 2 / 1;
    }

    .blog_grid_child-1 { grid-area: pic-1; }
    .blog_grid_child-2 { grid-area: pic-2; }
    .blog_grid_child-3 { grid-area: pic-3; }

    .blog_grid > div {
      min-height: 0;
      border-radius: var(--bs-border-radius, .375rem);
      overflow: hidden;
    }

    .blog_grid > div > a,
    .blog_grid figure.snip0015,
    .blog_grid figure.snip0015 img,
    .blog_grid > div > .placeholder-svg {
      display: block;
      width: 100%;
      height: 100%;
      margin: 0;
    }

    .blog_grid figure.snip0015 img {
      object-fit: cover;
      object-position: center;
    }

    .blog_grid > div > .placeholder-svg {
      background: var(--color-surface, #f4f4f4);
    }

    @media (max-width: 991px) {
      .blog_grid { gap: .875rem; aspect-ratio: 3 / 2; }
    }

    /* Phones: stack the three images at one consistent shape */
    @media (max-width: 575px) {
      .blog_grid {
        grid-template-columns: 1fr;
        grid-template-rows: none;
        grid-template-areas: "pic-1" "pic-2" "pic-3";
        aspect-ratio: auto;
      }
      .blog_grid > div { aspect-ratio: 4 / 3; }
    }

    .parent {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        grid-template-rows: 1fr 0.6fr;
        grid-column-gap: 10px;
        /* grid-row-gap: 15px; */
    }

    .pic1 {
        grid-area: 1 / 1 / 3 / 2;
    }

    .pic2 {
        grid-area: 1 / 2 / 2 / 3;
    }

    .pic3 {
        grid-area: 2 / 2 / 3 / 3;
    }




    /* @import url(https://fonts.googleapis.com/css?family=Raleway:400,200,300,800); */
figure.snip0015 {
  /* font-family: 'Raleway', Arial, sans-serif; */
  color: #fff;
  position: relative;
  overflow: hidden;
  /* margin: 10px; */
  /* min-width: 220px;
  max-width: 310px;
  max-height: 220px; */
  /* width: 100%; */
  background: #000000;
  text-align: center;
}
figure.snip0015 * {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
}
figure.snip0015 img {
  opacity: 1;
  width: 100%;
  -webkit-transition: opacity 0.35s;
  transition: opacity 0.35s;
}
figure.snip0015 figcaption {
  position: absolute;
  bottom: 0;
  left: 0;
  padding: 4em 4em;
  width: 100%;
  height: 100%;
}
figure.snip0015 figcaption::before {
  position: absolute;
  top: 50%;
  right: 30px;
  bottom: 50%;
  left: 30px;
  border-top: 1px solid rgba(255, 255, 255, 0.8);
  border-bottom: 1px solid rgba(255, 255, 255, 0.8);
  content: '';
  opacity: 0;
  background-color: #ffffff;
  -webkit-transition: all 0.3s;
  transition: all 0.3s;
  -webkit-transition-delay: 0.6s;
  transition-delay: 0.6s;
}
figure.snip0015 h2,
figure.snip0015 p {
  margin: 0 0 5px;
  /* font-size: 3rem; */
  opacity: 0;
  -webkit-transition: opacity 0.35s, -webkit-transform 0.35s;
  transition: opacity 0.35s,-webkit-transform 0.35s,-moz-transform 0.35s,-o-transform 0.35s,transform 0.35s;
}
figure.snip0015 h2 {
  word-spacing: -0.15em;
  font-weight: 300;
  text-transform: uppercase;
  -webkit-transform: translate3d(0%, 50%, 0);
  transform: translate3d(0%, 50%, 0);
  -webkit-transition-delay: 0.3s;
  transition-delay: 0.3s;
}
figure.snip0015 h2 span {
  font-weight: 800;
}
figure.snip0015 p {
  font-weight: 200	;
  -webkit-transition-delay: 0s;
  transition-delay: 0s;
}
figure.snip0015 a {
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  position: absolute;
  color: #ffffff;
}
figure.snip0015:hover img {
  opacity: 0.35;
}
figure.snip0015:hover figcaption h2 {
  opacity: 1;
  -webkit-transform: translate3d(0%, 0%, 0);
  transform: translate3d(0%, 0%, 0);
  -webkit-transition-delay: 0.3s;
  transition-delay: 0.3s;
}
figure.snip0015:hover figcaption p {
  opacity: 0.9;
  -webkit-transition-delay: 0.6s;
  transition-delay: 0.6s;
}
figure.snip0015:hover figcaption::before {
  background: rgba(255, 255, 255, 0);
  top: 30px;
  bottom: 30px;
  opacity: 1;
  -webkit-transition-delay: 0s;
  transition-delay: 0s;
}

</style>

{% schema %}
{
  "name": "Browse Blog",
  "class": "Browse Blog Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading Title",
      "default": "Follow Our Blog For New Recipes and Travel Stories"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Image source",
      "options": [
        { "value": "latest", "label": "Latest blog posts (automatic)" },
        { "value": "manual", "label": "Manual (images and links set below)" }
      ],
      "default": "latest",
      "info": "Automatic uses the cover image, title, excerpt and link of the three newest posts."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Used by automatic mode. Leave empty to use the default News blog."
    },
    {
      "type": "header",
      "content": "Manual images",
      "info": "Used when Image source is Manual, and for any slot the blog has no post for yet."
    },
    {
        "type": "text",
        "id": "hover_title_1",
        "label": "Image Hover Title 1",
        "default": "Where to Find the Best Street Tacos in SGV"
      },
      {
        "type": "text",
        "id": "hover_title_2",
        "label": "Image Hover Title 2",
        "default": "Kare Kare"
      },
      {
        "type": "text",
        "id": "hover_title_3",
        "label": "Image Hover Title 3",
        "default": "El Monte, The City of Friendly Neighbors"
      },
      {
        "type": "text",
        "id": "hover_paragraph_1",
        "label": "Image Hover Paragragh 1",
        "default": "From a slice of pineapple in your taco, to earthy goat birria"
      },
      {
        "type": "text",
        "id": "hover_paragraph_2",
        "label": "Image Hover Paragragh 2",
        "default": "Peanut sauce, shrimp paste, and fried liempo"
      },
      {
        "type": "text",
        "id": "hover_paragraph_3",
        "label": "Image Hover Paragragh 3",
        "default": "Hidden Gems"
      },
      {
        "type": "url",
        "id": "hover_link_1",
        "label": "Hover Image 1 Link"
    },
    {
        "type": "url",
        "id": "hover_link_2",
        "label": "Hover Image 2 Link"
    },
    {
        "type": "url",
        "id": "hover_link_3",
        "label": "Hover Image 3 Link"
    },
    {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1"
    },
    {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2"
    },
    {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3"
    }
  ],
  "presets": [
    {
      "category": "Browse",
      "name": "Browse Blog"
    }
  ]
}
{% endschema %}