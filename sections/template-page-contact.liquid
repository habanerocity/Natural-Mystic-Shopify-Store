<div class="header_banner-contact position-relative text-center p-3 p-md-5">
    <div class="col-md-5 p-lg-5 mx-auto my-5">
        <h1 class="display-4 turmeric">{{ section.settings.banner_heading | default: page.title }}</h1>
        {% if section.settings.banner_subheading != blank %}
<p class="lead text-light">{{ section.settings.banner_subheading }}</p>
{% endif %}
    </div>
</div>
<div class="container contact-page">
    {% if section.settings.form_heading != blank %}
        <p class="contact-page__intro">{{ section.settings.form_heading }}</p>
    {% endif %}

    <div class="contact-card">
        {% form 'contact', class: 'contact-form' %}
            {%- if form.posted_successfully? -%}
                <div class="contact-notice contact-notice--success" role="status" tabindex="-1" autofocus>
                    Thanks for your message. We'll get back to you within one business day.
                </div>
            {%- endif -%}

            {%- if form.errors -%}
                <div class="contact-notice contact-notice--error" role="alert" id="ContactFormErrors">
                    <p>Please check the following:</p>
                    <ul>
                        {%- for field in form.errors -%}
                            <li>
                                {%- if field == 'form' -%}
                                    {{ form.errors.messages[field] }}
                                {%- else -%}
                                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                                {%- endif -%}
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
            {%- endif -%}

            <div class="contact-form__grid">
                <div class="contact-field">
                    <label class="pdp-label" for="ContactFormName">Name</label>
                    <input class="contact-input" id="ContactFormName" name="contact[name]" type="text" autocomplete="name" required value="{{ form.name | escape }}">
                </div>
                <div class="contact-field">
                    <label class="pdp-label" for="ContactFormEmail">Email</label>
                    <input class="contact-input" id="ContactFormEmail" name="contact[email]" type="email" autocomplete="email" spellcheck="false" autocapitalize="off" required value="{{ form.email | escape }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="ContactFormErrors"{% endif %}>
                </div>
                <div class="contact-field">
                    <label class="pdp-label" for="ContactFormOrderNumber">Order # <span class="contact-field__optional">(optional)</span></label>
                    <input class="contact-input" id="ContactFormOrderNumber" name="contact[order_number]" type="text" autocomplete="off">
                </div>
                <div class="contact-field">
                    <label class="pdp-label" for="ContactFormPhone">Phone <span class="contact-field__optional">(optional)</span></label>
                    <input class="contact-input" id="ContactFormPhone" name="contact[phone]" type="tel" autocomplete="tel" value="{{ form.phone | escape }}">
                </div>
                <div class="contact-field contact-field--full">
                    <label class="pdp-label" for="ContactFormMessage">Message</label>
                    <textarea class="contact-input contact-input--textarea" id="ContactFormMessage" name="contact[body]" rows="7" required{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="ContactFormErrors"{% endif %}>{{ form.body | escape }}</textarea>
                </div>
            </div>

            <button class="btn rust btn-cta contact-form__submit" type="submit">Send message</button>
        {% endform %}
    </div>
</div>

<style>
    .header_banner-contact {
        background: var(--banner-overlay), url({{ section.settings.banner_image | img_url: "master"}});
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        height: 100%;
        width: 100%;
    }

    @media screen and (max-width: 600px){
        .header_banner-contact {
        background: var(--banner-overlay), url({{ section.settings.banner_image-mobile | img_url: "master"}});
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        height: 100%;
        width: 100%;
    }

    }
</style>

{% schema %}
{
    "name": "Page settings",
    "settings": [
    {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Heading Background Image"
    },
    {
        "type": "image_picker",
        "id": "banner_image-mobile",
        "label": "Mobile Heading Background Image"
    },
{
"type": "text",
"id": "banner_heading",
"label": "Heading",
"info": "Leave blank to use the page title."
},
{
"type": "text",
"id": "banner_subheading",
"label": "Subheading",
"info": "Leave blank to hide.",
"default": "Send us a message"
},
    {
        "type": "text",
        "id": "form_heading",
        "label": "Form heading",
        "info": "Text above the contact form. Leave blank to hide.",
        "default": "Got a spicy query? Let's chat! Your satisfaction is our main ingredient."
    }
    ]
}
{% endschema %}